REGIMPACT_ENVIRONMENT=local
REGIMPACT_LOG_LEVEL=INFO
REGIMPACT_DATABASE_URL=postgresql+psycopg://regimpact:regimpact@localhost:5432/regimpact
REGIMPACT_ALLOWED_ORIGINS=http://localhost:3000
REGIMPACT_OBJECT_STORAGE_ROOT=/tmp/regimpact-objects
REGIMPACT_OBJECT_STORAGE_BACKEND=local
REGIMPACT_AZURE_STORAGE_ACCOUNT_URL=
REGIMPACT_AZURE_STORAGE_CONTAINER=documents
REGIMPACT_MAX_UPLOAD_BYTES=15728640
REGIMPACT_MAX_PDF_PAGES=500
REGIMPACT_MALWARE_SCANNER_MODE=development_allow
REGIMPACT_REDIS_URL=redis://localhost:6379/0
REGIMPACT_WORKER_TIME_LIMIT_MS=120000
REGIMPACT_SOURCE_ALLOWED_DOMAINS=example.com
REGIMPACT_SOURCE_REQUEST_TIMEOUT_SECONDS=20
REGIMPACT_API_BASE_URL=http://localhost:8000
REGIMPACT_EMBEDDING_PROVIDER=feature_hash
REGIMPACT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REGIMPACT_AUTH_MODE=legacy
REGIMPACT_JWT_SECRET=replace-with-at-least-32-random-characters
REGIMPACT_LOG_LEVEL=INFO
REGIMPACT_METRICS_ENABLED=true
REGIMPACT_ACCESS_TOKEN_MINUTES=30
REGIMPACT_ENTRA_TENANT_ID=replace-with-entra-tenant-uuid
REGIMPACT_ENTRA_ISSUER=https://login.microsoftonline.com/replace-with-entra-tenant-uuid/v2.0
REGIMPACT_ENTRA_API_AUDIENCE=replace-with-regimpact-api-client-uuid
REGIMPACT_ENTRA_JWKS_URL=https://login.microsoftonline.com/replace-with-entra-tenant-uuid/discovery/v2.0/keys
REGIMPACT_ENTRA_CLOCK_SKEW_SECONDS=120
REGIMPACT_ENTRA_MAX_TOKEN_LIFETIME_SECONDS=5400
REGIMPACT_ENTRA_JWKS_TIMEOUT_SECONDS=5
REGIMPACT_ENTRA_JWKS_CACHE_SECONDS=3600
REGIMPACT_COMPANION_ACCESS_ENABLED=false
REGIMPACT_COMPANION_CLIENT_ID=replace-with-companion-client-uuid
REGIMPACT_COMPANION_RATE_LIMIT_PER_MINUTE=120
REGIMPACT_COMPANION_SEARCH_RATE_LIMIT_PER_MINUTE=30
REGIMPACT_COMPANION_RATE_LIMIT_TIMEOUT_SECONDS=1
REGIMPACT_COMPANION_MAX_EVIDENCE_CHARS=50000
REGIMPACT_DEMO_MODE=false
REGIMPACT_COOKIE_SECURE=false
REGIMPACT_DEMO_ADMIN_EMAIL=admin@northstar.local
REGIMPACT_DEMO_ADMIN_PASSWORD=replace-for-local-demo-only
REGIMPACT_DEMO_ANALYST_EMAIL=analyst@northstar.local
REGIMPACT_DEMO_ANALYST_PASSWORD=replace-for-local-demo-only
REGIMPACT_DEMO_VIEWER_EMAIL=viewer@northstar.local
REGIMPACT_DEMO_VIEWER_PASSWORD=replace-for-local-demo-only
