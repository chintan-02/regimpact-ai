REGIMPACT_ENVIRONMENT=local
REGIMPACT_LOG_LEVEL=INFO
REGIMPACT_DATABASE_URL=postgresql+psycopg://regimpact:regimpact@localhost:5432/regimpact
REGIMPACT_ALLOWED_ORIGINS=http://localhost:3000
REGIMPACT_OBJECT_STORAGE_ROOT=/tmp/regimpact-objects
REGIMPACT_MAX_UPLOAD_BYTES=15728640
REGIMPACT_MAX_PDF_PAGES=500
REGIMPACT_MALWARE_SCANNER_MODE=development_allow
REGIMPACT_REDIS_URL=redis://localhost:6379/0
REGIMPACT_WORKER_TIME_LIMIT_MS=120000
REGIMPACT_SOURCE_ALLOWED_DOMAINS=example.com
REGIMPACT_SOURCE_REQUEST_TIMEOUT_SECONDS=20
REGIMPACT_API_BASE_URL=http://localhost:8000
REGIMPACT_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
REGIMPACT_EMBEDDING_PROVIDER=feature_hash
REGIMPACT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
